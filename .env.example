# OTTO Research Labs - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# REQUIRED - Core Services
# =============================================================================

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App Configuration
NEXT_PUBLIC_APP_URL=https://ottoresearch.io
NEXT_PUBLIC_APP_NAME=OTTO Research Labs

# =============================================================================
# REQUIRED - Stripe Billing
# =============================================================================

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Price IDs (run scripts/setup-stripe.ts to generate)
STRIPE_STARTER_PRICE_ID=price_xxx
STRIPE_GROWTH_PRICE_ID=price_xxx
STRIPE_PROFESSIONAL_PRICE_ID=price_xxx
STRIPE_ENTERPRISE_PRICE_ID=price_xxx

# =============================================================================
# REQUIRED - External APIs
# =============================================================================

# AutoDS Credentials
AUTODS_EMAIL=your-email@example.com
AUTODS_PASSWORD=your-password

# eBay API Credentials
EBAY_APP_ID=your-app-id
EBAY_DEV_ID=your-dev-id
EBAY_CERT_ID=your-cert-id
EBAY_ENVIRONMENT=production
EBAY_REDIRECT_URI=https://your-domain.com/api/ebay/callback

# Keepa API
KEEPA_API_KEY=your-keepa-key

# ZIK Analytics
ZIK_EMAIL=your-email@example.com
ZIK_PASSWORD=your-password

# =============================================================================
# REQUIRED - Email & Security
# =============================================================================

# SendGrid Email
SENDGRID_API_KEY=SG.xxx
EMAIL_FROM=noreply@your-domain.com

# Cron Job Security
CRON_SECRET=your-random-secret

# =============================================================================
# OPTIONAL - Error Monitoring (Sentry)
# =============================================================================

# Sentry DSN - Get from sentry.io project settings
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Sentry organization and project (for source maps upload)
SENTRY_ORG=your-org
SENTRY_PROJECT=otto-research

# Sentry auth token (for source maps upload - optional)
SENTRY_AUTH_TOKEN=

# =============================================================================
# OPTIONAL - Feature Flags
# =============================================================================

NEXT_PUBLIC_ENABLE_BILLING=true
NEXT_PUBLIC_ENABLE_ANALYTICS=true

# =============================================================================
# OPTIONAL - Automation & AI
# =============================================================================

# Browser Configuration (choose one):
# Option 1: Remote browser service (recommended for production/scale)
# Browserless.io: wss://chrome.browserless.io?token=YOUR_TOKEN
# Self-hosted: ws://your-browserless-server:3000
BROWSER_WS_ENDPOINT=

# Option 2: Local Chrome binary (for local development)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
PUPPETEER_HEADLESS=true

PROXY_LIST=http://proxy1:8080,http://proxy2:8080

# Anthropic (for product normalization)
ANTHROPIC_API_KEY=your-anthropic-api-key
